<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- main theme: black status bar + black navigation bar, light icons -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- launch theme: plain black screen (no icon: some phones, like Android 9 ones, showed the default android robot), then straight into the app -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
